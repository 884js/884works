---
import { Content } from '../../docs/ehon-sticker-book/support.md';

const title = 'えほんシール帳 | 884.works';
const url = 'https://884.works/ehon-sticker-book/';
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
		<meta name="description" content="iPhone と iPad のアプリ「えほんシール帳」のサポートとよくある質問" />
		<link rel="canonical" href={url} />
		<meta property="og:title" content={title} />
		<meta property="og:type" content="article" />
		<meta property="og:url" content={url} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
		/>
	</head>
	<body>
		<main>
			<article>
				<Content />
			</article>
			<footer><a href="/">884.works</a></footer>
		</main>
	</body>
</html>

<style is:global>
	:root {
		--bg: #f4f4f2;
		--fg: #111111;
		--muted: #666666;
		--line: #e3e3e0;
		--card: #ffffff;
		color-scheme: light dark;
	}

	@media (prefers-color-scheme: dark) {
		:root {
			--bg: #111111;
			--fg: #ededed;
			--muted: #9a9a9a;
			--line: #2a2a2a;
			--card: #1a1a1a;
		}
	}

	body {
		margin: 0;
		background: var(--bg);
		color: var(--fg);
		font-family: 'Inter', 'Zen Kaku Gothic New', sans-serif;
		font-size: 15px;
		line-height: 1.8;
		-webkit-font-smoothing: antialiased;
	}

	article h1 {
		margin: 0 0 16px;
		font-size: 24px;
		line-height: 1.4;
		font-weight: 700;
	}

	article h2 {
		margin: 40px 0 12px;
		padding-top: 24px;
		border-top: 1px solid var(--line);
		font-size: 18px;
		line-height: 1.5;
		font-weight: 700;
	}

	article h3 {
		margin: 24px 0 8px;
		font-size: 16px;
		font-weight: 700;
	}

	article p,
	article ul {
		margin: 0 0 12px;
	}

	article ul {
		padding-left: 1.4em;
	}

	article li {
		margin: 0 0 6px;
	}

	article a {
		color: inherit;
	}
</style>

<style>
	main {
		max-width: 680px;
		margin: 0 auto;
		padding: 56px 16px 48px;
	}

	footer {
		margin-top: 48px;
		padding-top: 24px;
		border-top: 1px solid var(--line);
		font-size: 13px;
		color: var(--muted);
	}

	footer a {
		color: inherit;
	}
</style>
