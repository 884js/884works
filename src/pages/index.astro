---
import { icons } from '../data/icons';
import { profile } from '../data/profile';

const title = `${profile.name} | 884.works`;
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={`${profile.name} (${profile.role}) のリンク集`} />
		<link rel="canonical" href="https://884.works/" />
		<meta property="og:title" content={title} />
		<meta property="og:type" content="profile" />
		<meta property="og:url" content="https://884.works/" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
		/>
	</head>
	<body>
		<main>
			<header class="profile">
				<img class="avatar" src={profile.avatar} alt="" width="88" height="88" />
				<div>
					<h1>{profile.name}</h1>
					<p class="role">{profile.role}</p>
				</div>
				{profile.bio && <p class="bio">{profile.bio}</p>}
			</header>

			<nav aria-label="リンク" class="links">
				{
					profile.links.map((link) => (
						<a href={link.href} target="_blank" rel="noopener noreferrer">
							<span class="label">
								<svg class="logo" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill={icons[link.icon].color}>
									<path d={icons[link.icon].path} />
								</svg>
								{link.label}
							</span>
							<span class="meta">
								{link.handle}
								<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
									<path d="M7 17L17 7" />
									<path d="M8 7h9v9" />
								</svg>
							</span>
						</a>
					))
				}
				<a href={`mailto:${profile.email}`} class="primary">
					<span class="label">メールを送る</span>
					<span class="meta">
						{profile.email}
						<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
							<path d="M4 6h16v12H4z" />
							<path d="M4 7l8 6 8-6" />
						</svg>
					</span>
				</a>
			</nav>

			<footer>© {new Date().getFullYear()} 884.works</footer>
		</main>
	</body>
</html>

<style is:global>
	:root {
		--bg: #f4f4f2;
		--fg: #111111;
		--muted: #666666;
		--line: #e3e3e0;
		--card: #ffffff;
		color-scheme: light dark;
	}

	@media (prefers-color-scheme: dark) {
		:root {
			--bg: #111111;
			--fg: #ededed;
			--muted: #9a9a9a;
			--line: #2a2a2a;
			--card: #1a1a1a;
		}
	}

	body {
		margin: 0;
		background: var(--bg);
		color: var(--fg);
		font-family: 'Inter', 'Zen Kaku Gothic New', sans-serif;
		font-size: 15px;
		line-height: 1.7;
		-webkit-font-smoothing: antialiased;
	}
</style>

<style>
	main {
		max-width: 440px;
		margin: 0 auto;
		padding: 88px 16px 48px;
		display: flex;
		flex-direction: column;
		gap: 40px;
	}

	.profile {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
		text-align: center;
	}

	.avatar {
		width: 88px;
		height: 88px;
		margin-bottom: 8px;
		border-radius: 999px;
		object-fit: cover;
		outline: 1px solid var(--line);
		outline-offset: -1px;
	}

	h1 {
		margin: 0;
		font-size: 24px;
		line-height: 1.3;
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	.role {
		margin: 2px 0 0;
		font-size: 14px;
		color: var(--muted);
	}

	.bio {
		margin: 0;
		max-width: 360px;
	}

	.links {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.links a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		min-height: 60px;
		padding: 0 20px;
		background: var(--card);
		border: 1px solid var(--line);
		border-radius: 14px;
		color: inherit;
		text-decoration: none;
		transition: border-color 0.15s, transform 0.15s;
	}

	.links a:hover {
		border-color: var(--muted);
	}

	.links a:active {
		transform: scale(0.99);
	}

	.links a:focus-visible {
		outline: 2px solid var(--fg);
		outline-offset: 2px;
	}

	.links .primary {
		background: var(--fg);
		border-color: var(--fg);
		color: var(--bg);
	}

	.links .primary:hover {
		border-color: var(--fg);
		opacity: 0.88;
	}

	.label {
		display: flex;
		align-items: center;
		gap: 12px;
		font-weight: 500;
	}

	.logo {
		flex: none;
	}

	.meta {
		display: flex;
		align-items: center;
		gap: 10px;
		min-width: 0;
		font-size: 13px;
		color: var(--muted);
		overflow-wrap: anywhere;
	}

	.primary .meta {
		color: inherit;
	}

	.meta svg {
		flex: none;
	}

	footer {
		text-align: center;
		font-size: 12px;
		color: var(--muted);
	}
</style>
